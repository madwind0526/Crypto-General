{
  "name": "crypto-currency-trading",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "fetch:upbit": "node scripts/fetch-upbit-market-data.mjs",
    "fetch:upbit:top30": "node scripts/fetch-upbit-top30.mjs",
    "fetch:upbit:top30:chunk0": "node scripts/fetch-upbit-top30-chunk.mjs 0",
    "fetch:upbit:top30:chunk1": "node scripts/fetch-upbit-top30-chunk.mjs 1",
    "fetch:upbit:top30:chunk2": "node scripts/fetch-upbit-top30-chunk.mjs 2",
    "fetch:upbit:1m:backtracking": "set UPBIT_CANDLE_UNIT=1&& set UPBIT_LOOKBACK_DAYS=7&& set UPBIT_CACHE_LABEL=upbit-krw-1m-backtracking&& set UPBIT_WRITE_PUBLIC=false&& node scripts/fetch-upbit-market-data.mjs",
    "fetch:upbit:1m:daily": "node scripts/fetch-upbit-1m-daily.mjs",
    "merge:upbit:top30": "node scripts/merge-upbit-market-chunks.mjs",
    "build:dashboard-cache": "node scripts/build-dashboard-market-cache.mjs",
    "build:dashboard-cache:1m:backtracking": "set MARKET_CACHE_PATH=data/market/upbit-krw-1m-backtracking.json&& set DASHBOARD_CANDLE_LIMIT=10080&& node scripts/build-dashboard-market-cache.mjs",
    "build:dashboard-results": "node scripts/build-dashboard-results.mjs",
    "persist:traders": "node scripts/persist-trader-plans.mjs",
    "paper:sim": "node scripts/paper-trading-sim.mjs",
    "paper:sim:1m:daily": "node scripts/paper-trading-1m-daily.mjs",
    "paper:daily-rollover": "node scripts/daily-rollover.mjs",
    "paper:marathon:day": "node scripts/day-trading-marathon.mjs",
    "paper:marathon:watchdog": "node scripts/marathon-watchdog.mjs",
    "ws:live": "node scripts/ws-live.mjs",
    "test": "vitest run"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "lightweight-charts": "^5.0.8",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "ws": "^8.20.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "typescript": "^5.7.3",
    "vite": "^6.0.7",
    "vitest": "^4.1.6"
  }
}
